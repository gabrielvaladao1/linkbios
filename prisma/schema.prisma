// SmartBio — Prisma schema
// Banco: PostgreSQL gerenciado pelo Supabase (auth + storage + db).
// Estratégia: tabela `users` (public) tem o mesmo id de `auth.users` do Supabase.
// O vínculo é mantido por trigger no banco (ver migration 0003_auth_trigger).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// ─── USUÁRIO ────────────────────────────────────────────────────────────────

model User {
  // id NÃO tem default(uuid()): vem de auth.users.id (Supabase Auth)
  id           String   @id @db.Uuid
  email        String   @unique
  slug         String   @unique
  name         String?
  bio          String?
  avatarUrl    String?  @map("avatar_url")
  whatsapp     String?
  plan         Plan     @default(FREE)
  stripeId     String?  @unique @map("stripe_customer_id")
  templateId      String  @default("minimal") @map("template_id")
  colorBg         String  @default("#ffffff") @map("color_bg")
  colorButton     String  @default("#000000") @map("color_button")
  colorText       String  @default("#ffffff") @map("color_text")
  fontFamily      String  @default("Inter")   @map("font_family")
  buttonStyle     String  @default("solid")   @map("button_style")     // solid | glass | outline
  buttonRoundness String  @default("round")   @map("button_roundness") // square | round | rounder | full
  buttonShadow    String  @default("soft")    @map("button_shadow")    // none | soft | strong | hard
  headerLayout    String  @default("classic") @map("header_layout")    // classic | hero
  bannerUrl       String? @map("banner_url")
  socialLinks     Json    @default("[]")      @map("social_links")     // [{platform, url}]
  hideBranding    Boolean @default(false)     @map("hide_branding")
  metaPixelId     String? @map("meta_pixel_id")    @db.VarChar(50)
  tiktokPixelId   String? @map("tiktok_pixel_id")  @db.VarChar(50)
  leadsEnabled    Boolean @default(false)     @map("leads_enabled")
  leadsHeading    String? @map("leads_heading")
  leadsButton     String? @map("leads_button")
  createdAt    DateTime @default(now())    @map("created_at")
  updatedAt    DateTime @updatedAt          @map("updated_at")

  links        Link[]
  pageViews    PageView[]
  linkClicks   LinkClick[]
  leads        Lead[]
  subscription Subscription?

  @@map("users")
}

enum Plan {
  FREE
  PRO
  BUSINESS
}

// ─── LINKS ──────────────────────────────────────────────────────────────────

model Link {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String
  url       String
  icon      String?
  position  Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt       @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clicks    LinkClick[]

  @@index([userId, position])
  @@map("links")
}

// ─── ANALYTICS ──────────────────────────────────────────────────────────────

model PageView {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  referrer  String?
  userAgent String?  @map("user_agent")
  country   String?
  ipHash    String?  @map("ip_hash")  // hash sha256(ip + dia) — dedup sem armazenar IP cru (LGPD-friendly)
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("page_views")
}

model LinkClick {
  id        String   @id @default(uuid()) @db.Uuid
  linkId    String   @map("link_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  link      Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([linkId, createdAt])
  @@index([userId, createdAt])
  @@map("link_clicks")
}

// ─── LEADS ──────────────────────────────────────────────────────────────────

model Lead {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  email     String
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, email])
  @@index([userId, createdAt])
  @@map("leads")
}

// ─── BILLING ────────────────────────────────────────────────────────────────

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @unique @map("user_id") @db.Uuid
  stripeSubscriptionId String             @unique @map("stripe_subscription_id")
  stripePriceId        String             @map("stripe_price_id")
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime           @map("current_period_start")
  currentPeriodEnd     DateTime           @map("current_period_end")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt       @map("updated_at")

  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  INCOMPLETE
}

// ─── WEBHOOKS ───────────────────────────────────────────────────────────────

model StripeEvent {
  id          String   @id
  eventType   String   @map("event_type")
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([processedAt])
  @@map("stripe_events")
}
